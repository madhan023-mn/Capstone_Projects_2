# AWS S3 (Optional: Falls back to local uploads if credentials not provided)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Payment Providers (Test Mode)
