PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.t1dgszk.mongodb.net/multivendor_marketplace?retryWrites=true&w=majority&compressors=zlib

# JWT Secret & Expiration
JWT_SECRET=internship_super_secret_jwt_key_2026_secure_key
JWT_EXPIRES_IN=7d

# Redis Cache (Optional: Falls back to in-memory if offline)
